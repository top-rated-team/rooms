# ---- Required for the AI expert agents (RAG over developers.openai.com/ads) ----
OPENAI_API_KEY=sk-...
# Chat model used by the agents. gpt-5-mini is the cost/latency default.
OPENAI_CHAT_MODEL=gpt-5-mini
# Embedding model used by scripts/build-kb.ts and runtime retrieval.
OPENAI_EMBED_MODEL=text-embedding-3-small

# ---- Persistence (optional) ----
# Leave unset to run fully in-memory (workspaces vanish on restart) — handy for local dev.
# Set to a Postgres/Neon URL for real persistence, then run: npm run db:push
DATABASE_URL=

# ---- Lead notifications (optional) ----
# Any inbound request for a human expert is POSTed here as JSON.
LEAD_WEBHOOK_URL=
# Comma-separated emails shown to the visitor as the humans on call.
LEAD_NOTIFY_EMAIL=dan@being.marketing

# ---- Deployment ----
PORT=5000
PUBLIC_BASE_URL=https://ai.top-rated.team

# ---- Added with the order path (September 2026) ----
# The password for /leads, the page listing every request for a person that has
# arrived. Without it that page cannot be opened at all. On Render this is
# generated for you — copy it out of the dashboard.
LEAD_INBOX_KEY=
# Optional. Without a key nothing sends email: requests are still stored and
# still reach the webhook and the inbox page.
RESEND_API_KEY=
# Required only if RESEND_API_KEY is set — the address notifications are sent
# from, on a domain verified with Resend.
LEAD_EMAIL_FROM=
# Optional. Where the on-disk copy of each request is written. Defaults to a
# directory inside the project.
LEAD_LOG_DIR=

# ---- Unipile (calendar and our WhatsApp number) ----
# Host and port of this tenant's Unipile API, with no scheme. Without it every Unipile path reports unavailable in a sentence.
UNIPILE_DSN=
# Authorises the whole Unipile workspace, not one account. Without it, same as a missing DSN. Never sent to the browser.
UNIPILE_API_KEY=
# Shared secret Unipile echoes in a header we name. Without it, inbound Unipile requests are refused.
UNIPILE_WEBHOOK_SECRET=
# The Google calendar account in Unipile that bookings are written into.
# REQUIRED: there is no default. It used to fall back to the owner's own
# account id, written into the source of a repository that is going public.
UNIPILE_CALENDAR_ACCOUNT_ID=
# The WhatsApp account in Unipile that answers room sign-in codes and booking
# confirmations. REQUIRED: there is no default, for the same reason.
UNIPILE_WHATSAPP_ACCOUNT_ID=

# ---- LinkedIn (Sign In with LinkedIn using OpenID Connect) ----
# Room binding uses these today. The booking popup's LinkedIn button does
# NOT — it is hardcoded off and the server half is sealed in routes.ts until
# the defects listed there are fixed, so setting these will not turn it on.
# Off a house host there is no WhatsApp path, so once that button works,
# LinkedIn sign-in and a typed address are the only two ways a booking can
# reach anybody.
#
# To get a client id: create an app at linkedin.com/developers against a
# LinkedIn Page you administer; request the Sign In with LinkedIn using
# OpenID Connect product; add the openid, profile and email scopes; register
# the redirect URI as PUBLIC_BASE_URL plus /api/booking/linkedin/callback
# (and /api/identity/linkedin/callback for room binding); put the client id
# and secret here. Email only arrives once that product is provisioned, and
# LinkedIn may still omit it from a response.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ---- Who may read /admin ----
# The people page lists everyone who has signed in, their contact details and
# links into their rooms — and a room address is the whole credential. So it is
# reachable only by an account that carries one of these identities, and with
# neither of them set the page answers 403 to everybody, including us.
# An address here must be one you can RECEIVE MAIL AT and that already has a
# room, because the email way in only writes to an address it already knows.
OPERATOR_EMAIL=
# The LinkedIn subject id of the operator — the `sub` from Sign In with
# LinkedIn, with or without the "linkedin:" prefix. Comma-separated for more
# than one person. This is the way in that needs no mailbox.
#
# HOW TO FIND YOURS, since nothing else prints it: sign in with LinkedIn, open
# /admin, and the refusal shows the exact line to paste. It is your own
# identifier — LinkedIn gives it to every site you sign into — and it opens
# nothing on its own; it only names which account this deployment listens to.
OPERATOR_LINKEDIN_SUB=
# On a house host LEAD_NOTIFY_EMAIL is the last fallback, because it is already
# the owner's address. A fork gets neither fallback: it sets its own.

# ---- AdGrant.AI template files ----
# NO NEW VARIABLE. The template CSVs are produced from shared/adgrant.ts and
# handed over behind the same sign-in as the rooms, which uses the LinkedIn,
# WhatsApp and Resend settings already above. Nothing about them is per-domain:
# one process answers both hosts, so the Resend key that sends a room link from
# top-rated.team sends one from adgrant.ai. The answer is written here because
# the question — which variables does adgrant.ai need — is a fair one to ask of
# this file rather than of a commit message.

# ---- Our own Google Calendar (the one bookings are written into) ----
# A service account with the calendar SHARED to it — no OAuth consent screen,
# no verification, no refresh token. Two steps by hand, once: enable the Google
# Calendar API in the project, and share the calendar with the service
# account's address with "Make changes to events".
# The whole service-account JSON, as one value. Without it there is no calendar
# to read availability from and nothing to write a booking into.
GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON=
# Which calendar. An address, e.g. someone@example.com. A fork puts its own.
GOOGLE_CALENDAR_ID=

# ---- Visitor Google Calendar (free/busy only) ----
# The owner's own Google Cloud app, separate from the scheduling connector.
# Asks for calendar.freebusy and nothing else. Without both, the booking
# picker does not mention a visitor calendar — a fork has no such app.
# Register the redirect URI as PUBLIC_BASE_URL plus /api/booking/calendar/callback.
GOOGLE_FREEBUSY_CLIENT_ID=
GOOGLE_FREEBUSY_CLIENT_SECRET=

# Pepper for the WhatsApp identifier stored against a claimed room. Without it the
# hash is per-process and does not compare across a restart; the boot log says so.
ROOM_HASH_PEPPER=
